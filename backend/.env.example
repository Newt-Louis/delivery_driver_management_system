DIRECT_URL=postgresql://malluser:mallpass@localhost:5434/malldb
JWT_SECRET=mall-jwt-secret-2024-change-in-production
REDIS_PASSWORD=change-this-redis-password
REDIS_URL=redis://:change-this-redis-password@localhost:6379
PORT=4000
NODE_ENV=development
# Relative paths resolve from the backend working directory.
LOCATION_CODE_GROUPS_FILE=../codeofconduct_location.json
