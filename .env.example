# Docker Compose reads this file when copied to .env at the project root.
POSTGRES_DB=malldb
POSTGRES_USER=malluser
POSTGRES_PASSWORD=mallpass
POSTGRES_PORT=5434

REDIS_PASSWORD=change-this-redis-password
REDIS_PORT=6379

# Backend datafile storage. Relative paths resolve from the project root.
DATAFILE_ROOT=./datafile
DATAFILE_MAX_UPLOAD_BYTES=104857600
JSON_BODY_LIMIT=15mb

# Frontend (for local dev outside Docker)
VITE_API_URL=http://localhost:4000
VITE_SOCKET_URL=http://localhost:4000
